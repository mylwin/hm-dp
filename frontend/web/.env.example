# Direct Spring Boot target. The development proxy strips /api.
API_PROXY_TARGET=http://127.0.0.1:8081

# Browser API prefix; keep same-origin /api in production.
VITE_API_BASE=/api

# 抢购固定使用 /voucher-order/reliable；后端须启用新 API、Outbox、消费者及维护任务。

# 本地秒杀维护页；仅 npm run dev 有效，生产构建始终不注册该入口。
# 只配置开关，不在 VITE_* 变量中填写运维令牌。
VITE_SECKILL_OPS_ENABLED=false
